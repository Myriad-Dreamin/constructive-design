{
  "name": "constructive-design",
  "version": "0.1.0-rc2",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "dsc": "dist/index.js"
  },
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm build:vscode && tsc -p tsconfig.json",
    "build:cli": "pnpm scala:ls:fastLink && tsc -p tsconfig.json",
    "build:grammar": "pnpm --dir editors/vscode build:syntax",
    "build:sea": "pnpm build:cli && node scripts/build-sea.mjs",
    "build:syntax": "pnpm --dir editors/vscode build:syntax",
    "build:vscode": "pnpm --dir editors/vscode build:vscode",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm --dir editors/vscode typecheck",
    "draft-release": "node scripts/draft-release.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint .",
    "local:vscode": "pnpm --dir editors/vscode local:vscode",
    "package": "pnpm --dir editors/vscode package",
    "scala:compile": "sbt compile",
    "scala:run": "scala-cli run packages/design/src/main/scala packages/design-cli/src/main/scala --server=false",
    "scala:cli:fastLink": "sbt designCli/fastLinkJS",
    "scala:cli:run": "sbt designCli/run",
    "scala:ls:fastLink": "mkdir -p editors/vscode/dist/scala/design-ls && scala-cli package packages/design/src/main/scala packages/design-ls/src/main/scala --power --js --js-module-kind esmodule --js-mode fastLinkJS --output editors/vscode/dist/scala/design-ls/main.js --force --server=false",
    "scala:sbt-fastLink": "sbt designCli/fastLinkJS",
    "scala:sbt-run": "sbt designCli/run",
    "start": "node dist/index.js",
    "test": "sbt test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
